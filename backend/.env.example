# ==============================================================================
# Bucketly Backend Environment Configuration (Template)
# Copy this file to '.env' for local configuration or export these variables in your shell.
# NEVER commit your actual '.env' or database secrets to version control.
# ==============================================================================

# Server Port
SERVER_PORT=8080

# MySQL Database Connection
# Recommendation: In production/long-term, use a dedicated application user rather than 'root'.
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/bucketly?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=bucketly_user
SPRING_DATASOURCE_PASSWORD=your_secure_password_here

